# ============================================================
# Evalia-AI 生产环境配置模板
#
# 使用方法：
#   cp .env.prod.example .env
#   （.env 已被 .gitignore 排除，不会提交到仓库）
#
# 所有默认密码务必修改，否则公网部署存在严重安全隐患
# ============================================================

# 你的域名（需先将 A 记录指向服务器 IP，Caddy 会自动签发 HTTPS 证书）
DOMAIN=evalia.example.com

# ---------- MySQL ----------
DB_USERNAME=root
DB_PASSWORD=请改成强密码

# ---------- MinIO ----------
MINIO_USER=minioadmin
MINIO_PASSWORD=请改成强密码
MINIO_BUCKET=llm-eval

# ---------- 模型 API Key 加密密钥 ----------
# 生成 32 字节 Base64 密钥：  openssl rand -base64 32
EVAL_ENCRYPT_KEY=请粘贴生成的值